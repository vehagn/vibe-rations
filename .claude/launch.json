{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "serve"
      ],
      "port": 8088
    },
    {
      "name": "web-running",
      "url": "http://localhost:8088",
      "port": 8088
    },
    {
      "name": "solver",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "run",
        "--rm",
        "--name",
        "vibe-rations-solver",
        "-p",
        "127.0.0.1:8090:8088",
        "vibe-rations-solver:test"
      ],
      "port": 8090
    }
  ]
}
